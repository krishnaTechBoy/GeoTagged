# =============================
# React Native Git Ignore File
# =============================

# ✅ Dependencies
node_modules/

# ✅ Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ✅ Build output
android/app/build/
ios/build/
ios/DerivedData/

# ✅ Metro bundler cache
.expo/
.expo-shared/

# ✅ Local environment variables
.env
.env.local
.env.*.local

# ✅ macOS system files
.DS_Store

# ✅ VSCode and JetBrains IDEs
.vscode/
.idea/

# ✅ Xcode specific files
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xcworkspace
*.xcscheme
*.xcscmblueprint
*.xccheckout

# ✅ CocoaPods
ios/Pods/

# ✅ Android Studio / Gradle
.gradle/
android/.gradle/
android/.idea/
android/local.properties
*.iml
.cxx/
